{
  "name": "femkit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The femkit web page, built by `python -m femkit web build` into femkit/web/static/ (docs/contracts/api.md § 5.3)",
  "scripts": {
