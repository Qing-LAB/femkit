{
  "name": "femkit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The femkit web page, built by `femkit web build` into femkit/web/static/ (docs/contracts/web.md § 3)",
  "scripts": {
    "types": "json2ts --input src/generated/schemas.json --output src/generated/schemas.ts --unreachableDefinitions --no-additionalProperties --bannerComment \"// generated by web build from src/generated/schemas.json -- do not edit\"",
    "build": "npm run types && tsc --noEmit && vite build"
  },
  "femkit": {
    "sources": [
      "index.html",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "vite.config.ts",
      "src",
      "public"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.16.0",
    "@codemirror/commands": "6.5.0",
    "@codemirror/lang-python": "6.1.5",
    "@codemirror/language": "6.10.1",
    "@codemirror/legacy-modes": "6.4.0",
    "@codemirror/lint": "6.5.0",
    "@codemirror/search": "6.5.6",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.3.6",
    "elkjs": "0.9.3",
    "katex": "0.16.11",
    "lucide-react": "0.460.0",
    "markdown-it": "14.1.0",
    "mermaid": "11.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/markdown-it": "14.1.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
